# All variables are optional: without them Fanthom runs in keyless demo mode (seed data + local AI fallback).

# Supabase project URL (enables the Supabase repo together with the service role key)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (browser uploads to signed URLs)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key — server only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key — enables live Claude (claude-sonnet-5) summaries, Ask, catch-up, email
ANTHROPIC_API_KEY=
# Deepgram API key — enables real diarized transcription for uploads
DEEPGRAM_API_KEY=
# AssemblyAI API key (optional) — fallback transcription provider
ASSEMBLYAI_API_KEY=
# Public base URL used to build share/clip links, e.g. https://fanthom.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
